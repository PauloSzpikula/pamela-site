---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Experience from '../components/home/Experience.astro';
import Portfolio from '../components/home/Portfolio.astro';
import ReviewSection from '../components/reviews/ReviewSection.astro';
import CtaFinal from '../components/home/CtaFinal.astro';
import Footer from '../components/home/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { organizationSchema, localBusinessSchema, photographerSchema } from '../config/schema';

const schema = [organizationSchema(), localBusinessSchema(), photographerSchema()];
---

<Layout
	preloadImage={{ desktop: '/images/hero/hero-home.webp', mobile: '/images/hero/hero-mobile.webp' }}
>
	<Hero />
	<About />
	<Experience />
	<Portfolio />
	<ReviewSection />
	<CtaFinal />
	<Footer />

	<JsonLd schema={schema} />
</Layout>
