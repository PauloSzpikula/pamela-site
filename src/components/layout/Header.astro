---
import Logo from './Logo.astro';
import Nav from './Nav.astro';
import MobileNav from './MobileNav.astro';
import { whatsappHref } from '../../config/contact';
---

<header
	id="site-header"
	class="group fixed inset-x-0 top-0 z-50 border-b border-transparent bg-transparent transition-colors duration-300 [&.is-scrolled]:border-border [&.is-scrolled]:bg-bg"
>
	<div class="site-container grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-md md:h-[78px]">
		<Logo />
		<Nav />
		<div class="flex items-center justify-end gap-sm">
			<a
				href={whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary hidden lg:inline-flex"
			>
				Agendar pelo WhatsApp
			</a>
			<MobileNav />
		</div>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');

	const updateHeaderState = () => {
		header?.classList.toggle('is-scrolled', window.scrollY > 0);
	};

	updateHeaderState();
	window.addEventListener('scroll', updateHeaderState, { passive: true });
</script>
