---
import { navItems } from '../../data/nav';
---

<div class="relative md:hidden">
	<button
		id="mobile-nav-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="mobile-nav-menu"
		class="text-background transition-colors duration-300 group-[.is-scrolled]:text-text"
	>
		Menu
	</button>

	<nav
		id="mobile-nav-menu"
		class="absolute right-0 top-full hidden w-56 flex flex-col gap-sm border border-border bg-background p-md shadow-sm"
		aria-label="Navegação mobile"
	>
		<ul class="flex flex-col gap-sm">
			{
				navItems.map((item) => (
					<li>
						<a href={item.href} class="hover:text-primary">
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<a href="#" class="btn btn-primary">Agendar pelo WhatsApp</a>
	</nav>
</div>

<script>
	const toggle = document.getElementById('mobile-nav-toggle');
	const menu = document.getElementById('mobile-nav-menu');

	toggle?.addEventListener('click', () => {
		const isHidden = menu?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!isHidden));
	});
</script>
