---
import { navItems } from '../../data/nav';
import { whatsappHref } from '../../config/contact';
---

<div class="relative lg:hidden">
	<button
		id="mobile-nav-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="mobile-nav-menu"
		aria-label="Abrir menu"
		class="flex h-11 w-11 items-center justify-center text-bg transition-colors duration-300 group-[.is-scrolled]:text-text"
	>
		<svg
			id="mobile-nav-icon-open"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			class="h-5 w-5"
		>
			<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
		</svg>
		<svg
			id="mobile-nav-icon-close"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			class="hidden h-5 w-5"
		>
			<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
		</svg>
	</button>

	<nav
		id="mobile-nav-menu"
		class="invisible absolute right-0 top-full w-56 flex translate-x-3 flex-col gap-sm border border-border bg-bg p-md opacity-0 shadow-sm transition-all duration-200 ease-out [&.is-open]:visible [&.is-open]:translate-x-0 [&.is-open]:opacity-100"
		aria-label="Navegação mobile"
	>
		<ul class="flex flex-col gap-sm">
			{
				navItems.map((item) => (
					<li>
						<a href={item.href} class="hover:text-gold">
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<a
			href={whatsappHref}
			data-cta="mobile_nav"
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-primary"
		>
			Agendar pelo WhatsApp
		</a>
	</nav>
</div>

<script>
	const toggle = document.getElementById('mobile-nav-toggle');
	const menu = document.getElementById('mobile-nav-menu');
	const iconOpen = document.getElementById('mobile-nav-icon-open');
	const iconClose = document.getElementById('mobile-nav-icon-close');

	const setOpen = (isOpen: boolean) => {
		menu?.classList.toggle('is-open', isOpen);
		toggle?.setAttribute('aria-expanded', String(isOpen));
		toggle?.setAttribute('aria-label', isOpen ? 'Fechar menu' : 'Abrir menu');
		iconOpen?.classList.toggle('hidden', isOpen);
		iconClose?.classList.toggle('hidden', !isOpen);
	};

	const isOpen = () => menu?.classList.contains('is-open') ?? false;

	toggle?.addEventListener('click', (e) => {
		e.stopPropagation();
		setOpen(!isOpen());
	});

	// Fecha ao escolher um item (inclusive âncoras da mesma página, como /#sobre na Home),
	// ao tocar fora do menu e com Esc.
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

	document.addEventListener('click', (e) => {
		if (isOpen() && !menu?.contains(e.target as Node)) setOpen(false);
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen()) {
			setOpen(false);
			toggle?.focus();
		}
	});
</script>
