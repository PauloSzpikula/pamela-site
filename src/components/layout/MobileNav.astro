---
import { navItems } from '../../data/nav';
import { whatsappHref } from '../../config/contact';
---

<div class="relative lg:hidden">
	<button
		id="mobile-nav-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="mobile-nav-menu"
		aria-label="Abrir menu"
		class="flex h-10 w-10 items-center justify-center text-bg transition-colors duration-300 group-[.is-scrolled]:text-text"
	>
		<svg
			id="mobile-nav-icon-open"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			class="h-5 w-5"
		>
			<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
		</svg>
		<svg
			id="mobile-nav-icon-close"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			class="hidden h-5 w-5"
		>
			<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
		</svg>
	</button>

	<nav
		id="mobile-nav-menu"
		class="absolute right-0 top-full hidden w-56 flex flex-col gap-sm border border-border bg-bg p-md shadow-sm"
		aria-label="Navegação mobile"
	>
		<ul class="flex flex-col gap-sm">
			{
				navItems.map((item) => (
					<li>
						<a href={item.href} class="hover:text-gold">
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<a
			href={whatsappHref}
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-primary"
		>
			Agendar pelo WhatsApp
		</a>
	</nav>
</div>

<script>
	const toggle = document.getElementById('mobile-nav-toggle');
	const menu = document.getElementById('mobile-nav-menu');
	const iconOpen = document.getElementById('mobile-nav-icon-open');
	const iconClose = document.getElementById('mobile-nav-icon-close');

	toggle?.addEventListener('click', () => {
		const isHidden = menu?.classList.toggle('hidden');
		const isOpen = !isHidden;

		toggle.setAttribute('aria-expanded', String(isOpen));
		toggle.setAttribute('aria-label', isOpen ? 'Fechar menu' : 'Abrir menu');
		iconOpen?.classList.toggle('hidden', isOpen);
		iconClose?.classList.toggle('hidden', !isOpen);
	});
</script>
