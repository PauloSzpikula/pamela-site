---
import { navItems } from '../../data/nav';
---

<nav class="hidden md:flex md:justify-center" aria-label="Navegação principal">
	<ul class="flex items-center gap-lg">
		{
			navItems.map((item) => (
				<li>
					<a
						href={item.href}
						class="text-bg transition-colors duration-300 hover:text-gold group-[.is-scrolled]:text-text"
					>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
