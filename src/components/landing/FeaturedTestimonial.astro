---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
	eyebrow: string;
	quote: string;
	author: string;
	context: string;
	image: string;
	imageAlt: string;
}

const { eyebrow, quote, author, context, image, imageAlt } = Astro.props;
const hasImage = fs.existsSync(path.join(process.cwd(), 'public', image));
---

<section class="border-t border-border">
	<div
		data-reveal
		class="site-container grid grid-cols-1 gap-2xl py-12 md:grid-cols-[1fr_2fr] md:items-center md:py-24"
	>
		<div class="aspect-[4/5] max-w-[22rem] overflow-hidden bg-surface shadow-[0_25px_60px_-20px_rgba(42,36,32,0.25)] md:max-w-none">
			{
				hasImage ? (
					<img src={image} alt={imageAlt} loading="lazy" class="h-full w-full object-cover" />
				) : (
					<div class="flex h-full w-full items-center justify-center bg-[linear-gradient(135deg,var(--color-bg-alt)_0%,var(--color-bg)_100%)]">
						<svg
							viewBox="0 0 48 48"
							fill="none"
							stroke="currentColor"
							stroke-width="1"
							class="h-10 w-10 text-border"
							aria-hidden="true"
						>
							<circle cx="24" cy="17" r="8" />
							<path d="M9 41c1.5-8.5 7.5-13 15-13s13.5 4.5 15 13" stroke-linecap="round" />
						</svg>
					</div>
				)
			}
		</div>

		<div class="flex flex-col gap-lg">
			<small class="font-semibold uppercase tracking-[0.2em] text-accent">{eyebrow}</small>

			<span aria-hidden="true" class="font-heading text-6xl leading-none text-gold">"</span>

			<p class="max-w-[30rem] font-heading text-xl italic leading-[1.6] text-text md:text-2xl">
				{quote}
			</p>

			<div class="flex items-center gap-sm pt-md">
				<span class="h-px w-10 bg-border" aria-hidden="true"></span>
				<div class="flex flex-col gap-[2px]">
					<span class="font-heading text-lg text-text">{author}</span>
					<small class="uppercase tracking-[0.15em] text-text-muted">{context}</small>
				</div>
			</div>
		</div>
	</div>
</section>
