---
interface Props {
	eyebrow: string;
	title: string;
	paragraphs: string[];
	image: string;
	imageAlt: string;
}

const { eyebrow, title, paragraphs, image, imageAlt } = Astro.props;
---

<section class="border-t border-border">
	<div
		data-reveal
		class="site-container grid grid-cols-1 gap-2xl py-12 md:grid-cols-[5fr_3fr] md:items-center md:py-32"
	>
		<div class="aspect-[4/5] overflow-hidden bg-surface shadow-[0_25px_60px_-20px_rgba(42,36,32,0.25)] md:aspect-[3/4]">
			<img src={image} alt={imageAlt} loading="lazy" class="h-full w-full object-cover" />
		</div>

		<div class="flex flex-col gap-xl md:pl-xl">
			<small class="font-semibold uppercase tracking-[0.2em] text-accent">{eyebrow}</small>

			<h2 class="max-w-[22rem]">{title}</h2>

			<div class="flex max-w-[26rem] flex-col gap-md">
				{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</div>
</section>
