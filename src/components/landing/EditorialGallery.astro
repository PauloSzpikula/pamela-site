---
type GallerySpan = 'lg' | 'wide' | 'tall' | 'sm';

interface GalleryItem {
	span: GallerySpan;
	image?: string;
	alt?: string;
}

interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	items: GalleryItem[];
}

const { eyebrow, title, description, items } = Astro.props;

const spanClasses: Record<GallerySpan, string> = {
	lg: 'md:col-span-2 md:row-span-2',
	wide: 'md:col-span-2 md:row-span-1',
	tall: 'md:col-span-1 md:row-span-2',
	sm: 'md:col-span-1 md:row-span-1',
};
---

<section id="galeria" class="scroll-mt-20 border-t border-border">
	<div data-reveal class="site-container flex flex-col gap-2xl py-12 md:py-24">
		<div class="flex flex-col gap-sm">
			<small class="font-semibold uppercase tracking-[0.2em] text-accent">{eyebrow}</small>
			<h2 class="max-w-[42rem]">{title}</h2>
			{description && <p class="max-w-[36rem] text-text-muted">{description}</p>}
		</div>

		<div class="grid grid-cols-1 gap-lg md:grid-cols-4 md:gap-xl md:[grid-auto-rows:14rem]">
			{
				items.map((item) => (
					<div
						class:list={[
							'group relative aspect-[4/5] overflow-hidden border border-border bg-surface transition-colors duration-300 hover:border-gold md:aspect-auto',
							spanClasses[item.span],
						]}
					>
						{item.image ? (
							<img
								src={item.image}
								alt={item.alt ?? ''}
								loading="lazy"
								class="h-full w-full object-cover transition-transform duration-[400ms] ease-out group-hover:scale-[1.03]"
							/>
						) : (
							<div class="flex h-full w-full items-center justify-center bg-[linear-gradient(135deg,var(--color-bg-alt)_0%,var(--color-bg)_100%)]">
								<svg
									viewBox="0 0 48 48"
									fill="none"
									stroke="currentColor"
									stroke-width="1"
									class="h-8 w-8 text-border transition-colors duration-300 group-hover:text-gold"
									aria-hidden="true"
								>
									<rect x="5" y="13" width="38" height="28" rx="2" />
									<circle cx="24" cy="27" r="8" />
									<path d="M17 13l2.5-5h9l2.5 5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								<span class="sr-only">Fotografia em breve</span>
							</div>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
