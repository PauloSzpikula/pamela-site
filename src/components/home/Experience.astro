---
const steps = [
	{
		number: '01',
		title: 'Conversamos',
		description: 'Entendo sua história, expectativas e estilo.',
	},
	{
		number: '02',
		title: 'Planejamos',
		description: 'Escolhemos cenário, roupas, horários e todos os detalhes.',
	},
	{
		number: '03',
		title: 'Vivemos o momento',
		description: 'O ensaio acontece de forma leve, natural e sem poses forçadas.',
	},
	{
		number: '04',
		title: 'Memórias para sempre',
		description: 'Você recebe fotografias tratadas com cuidado para guardar por toda a vida.',
	},
];
---

<section class="border-t border-border">
	<div data-reveal class="site-container flex flex-col gap-2xl py-12 md:py-24">
		<div class="flex flex-col gap-sm">
			<small class="font-semibold uppercase tracking-[0.2em] text-accent">A Experiência</small>

			<h2 class="max-w-[42rem]">
				Cada ensaio é pensado para que você viva o momento, enquanto eu cuido de transformá-lo em
				memória.
			</h2>
		</div>

		<div class="grid grid-cols-1 gap-2xl md:grid-cols-4 md:gap-lg">
			{
				steps.map((step) => (
					<div class="group relative flex flex-col gap-md border-l-2 border-border pl-lg transition-colors duration-300 hover:border-gold md:border-l-0 md:border-t-2 md:pl-0 md:pt-lg">
						<span class="absolute -left-[5px] top-0 h-2 w-2 rounded-full bg-border transition-colors duration-300 group-hover:bg-gold md:-top-[5px] md:left-0" />
						<span class="font-heading text-4xl font-light text-text-muted transition-colors duration-300 group-hover:text-gold">
							{step.number}
						</span>
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
