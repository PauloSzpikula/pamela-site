---
import Logo from '../layout/Logo.astro';
import { navItems } from '../../data/nav';
import { portfolioCategories } from '../../data/portfolio';
import { whatsappHref } from '../../config/contact';
import { instagramHref } from '../../config/social';
---

<footer class="border-t border-border bg-bg">
	<div class="site-container flex flex-col gap-lg py-8 md:py-12">
		<div class="grid grid-cols-1 gap-lg md:grid-cols-4 md:gap-md">
			<div class="flex flex-col gap-sm">
				<Logo dark loading="lazy" />
				<p class="max-w-[20rem] text-text-muted">
					Fotografias que preservam momentos únicos com sensibilidade e delicadeza.
				</p>
			</div>

			<div class="flex flex-col gap-sm">
				<h3 class="text-sm font-semibold uppercase tracking-wide text-text">Navegação</h3>
				<ul class="flex flex-col gap-sm">
					{
						navItems.map((item) => (
							<li>
								<a
									href={item.href}
									class="text-text-muted transition-colors duration-300 hover:text-gold"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="flex flex-col gap-sm">
				<h3 class="text-sm font-semibold uppercase tracking-wide text-text">Ensaios</h3>
				<ul class="flex flex-col gap-sm">
					{
						portfolioCategories.map((category) => (
							<li>
								<a
									href={`/${category.slug}`}
									class="text-text-muted transition-colors duration-300 hover:text-gold"
								>
									{category.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="flex flex-col gap-sm">
				<h3 class="text-sm font-semibold uppercase tracking-wide text-text">Atendimento</h3>
				<ul class="flex flex-col gap-sm text-text-muted">
					<li>São José dos Pinhais</li>
					<li>Curitiba e Região Metropolitana</li>
					<li class="pt-xs">
						<a
							href={whatsappHref}
							target="_blank"
							rel="noopener noreferrer"
							class="transition-colors duration-300 hover:text-gold"
						>
							WhatsApp
						</a>
					</li>
					<li>
						<a
							href={instagramHref}
							target="_blank"
							rel="noopener noreferrer"
							class="transition-colors duration-300 hover:text-gold"
						>
							Instagram
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="border-t border-border" aria-hidden="true"></div>

		<div
			class="flex flex-col items-center gap-sm text-center text-text-muted md:flex-row md:items-center md:justify-between md:text-left"
		>
			<small>© 2026 Pamela Teice Fotografia. Todos os direitos reservados.</small>
			<small>Feito com carinho para preservar histórias.</small>
		</div>
	</div>
</footer>
