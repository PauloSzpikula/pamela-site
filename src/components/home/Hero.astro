---
---

<section class="relative flex min-h-[90vh] items-center overflow-hidden md:min-h-screen">
	<img
		src="/images/hero/hero-home.jpg"
		alt="Ensaio fotográfico em família"
		width="5000"
		height="3333"
		class="absolute inset-0 h-full w-full object-cover object-[50%_25%] md:scale-[1.3] md:translate-x-[18%] md:translate-y-[14%]"
		loading="eager"
		fetchpriority="high"
	/>

	<div
		class="absolute inset-0 bg-gradient-to-r from-text/55 via-text/15 to-transparent"
		aria-hidden="true"
	>
	</div>

	<div class="site-container relative z-10 w-full">
		<div class="flex max-w-[36rem] -translate-y-lg flex-col gap-lg pl-lg text-background md:pl-2xl">
			<small class="text-base font-semibold uppercase tracking-[0.25em] text-primary-light">
				Fotografia com propósito
			</small>

			<h1>Fotografias que preservam os momentos mais importantes da sua família.</h1>

			<div class="h-px w-16 bg-primary" aria-hidden="true"></div>

			<p>
				Atendimento personalizado em São José dos Pinhais, Curitiba e Região Metropolitana.
			</p>

			<div class="flex flex-wrap gap-sm">
				<a href="#" class="btn btn-primary gap-2">
					<svg viewBox="0 0 32 32" fill="currentColor" class="h-4 w-4" aria-hidden="true">
						<path
							d="M16.004 3C9.377 3 4 8.377 4 15.004c0 2.648.87 5.09 2.342 7.07L4 29l7.106-2.32a11.94 11.94 0 0 0 4.898 1.04h.004c6.627 0 12.004-5.377 12.004-12.004C28.008 8.377 22.631 3 16.004 3Zm0 21.86a9.83 9.83 0 0 1-5.02-1.38l-.36-.214-4.216 1.377 1.396-4.106-.234-.375A9.84 9.84 0 0 1 6.14 15c0-5.44 4.424-9.86 9.864-9.86 5.44 0 9.86 4.42 9.86 9.86 0 5.44-4.42 9.86-9.86 9.86Zm5.42-7.386c-.297-.148-1.758-.867-2.03-.966-.273-.099-.472-.148-.67.148-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.148-1.254-.462-2.39-1.474-.883-.788-1.48-1.76-1.653-2.058-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.148-.173.198-.297.297-.495.099-.198.05-.372-.025-.52-.075-.148-.67-1.613-.918-2.21-.242-.58-.487-.5-.67-.51-.173-.008-.372-.01-.57-.01-.198 0-.52.075-.792.372-.273.297-1.04 1.016-1.04 2.478 0 1.462 1.065 2.874 1.213 3.072.148.198 2.096 3.2 5.08 4.487.71.306 1.263.489 1.694.626.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.005-1.413.248-.694.248-1.29.173-1.413-.074-.124-.272-.198-.57-.347Z"
						></path>
					</svg>
					Agendar pelo WhatsApp
				</a>
				<a
					href="#"
					class="btn btn-secondary border-background/60 text-background hover:border-primary hover:text-primary"
				>
					Conhecer os Ensaios
				</a>
			</div>
		</div>
	</div>

	<div
		class="absolute inset-x-0 bottom-lg z-10 hidden flex-col items-center gap-sm text-background md:flex"
	>
		<small class="text-background">Role para descobrir</small>
		<svg viewBox="0 0 24 36" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-4">
			<rect x="1" y="1" width="22" height="34" rx="11"></rect>
			<circle cx="12" cy="10" r="2" fill="currentColor" stroke="none"></circle>
		</svg>
	</div>
</section>
